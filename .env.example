# 이 파일을 .env로 복사한 후 비밀번호 세 항목을 직접 변경하세요.
# .env는 저장소/공유 파일에 올리지 마세요. 프런트엔드에는 이 값을 전달하지 않습니다.
MYSQL_DATABASE=joji_community
MYSQL_USER=joji_app
MYSQL_PASSWORD=replace_with_a_long_random_database_password
MYSQL_ROOT_PASSWORD=replace_with_a_different_long_root_password
HTTP_PORT=8088
# 쉼표 사이 공백 없이 기입합니다. 외부 IP/도메인 접속 시 정확한 주소를 추가하세요.
APP_ORIGINS=http://localhost:8088,http://localhost:5173
# 로컬 HTTP는 false. HTTPS 역방향 프록시를 구성했다면 true로 변경하세요.
COOKIE_SECURE=false
# 학습용 예시 글은 최초 1회만 삽입합니다. 실사용 데이터를 원하면 false로 바꾸세요.
APP_SEED_DEMO=true
DEMO_POST_PASSWORD=replace_with_a_demo_post_password
